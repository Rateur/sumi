---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import { Image } from 'astro:assets';
import pkg from '../../../package.json';
import painting from '../assets/jinshan-band.webp';
import cover from '../assets/cover.webp';
import { home, type Lang } from '../i18n/home';
import { motionVars } from '../../../src/lib/curves';
import { BUBBLE, GAP, TAG, TAG_GAP } from '../../../src/lib/shapes';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const version = pkg.version;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = lang === 'fr' ? `${base}fr/` : base;
const otherHome = lang === 'fr' ? base : `${base}fr/`;
const download = 'https://github.com/Rateur/sumi/releases/latest/download/Sumi-setup.exe';
const repo = 'https://github.com/Rateur/sumi';
const mark =
	'M292 330H732A80 80 0 0 1 732 490H566C540 490 522.5 525.3 553.1 551A64 64 0 1 1 470.9 551C501.5 525.3 484 490 458 490H292A80 80 0 0 1 292 330Z';
const og = new URL(`${base}og.png`, Astro.site).href;
// The app's own island, built by `npm run showcase`, in the page's language, with a made-up song. The tint is what the
// app reads from the cover.
const song = new URLSearchParams({ title: 'West Lake', artist: 'Ink & Gold', art: cover.src, color: '#c6ab95' });
const island = `${base}island/index.html?lang=${lang}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.title}</title>
		<meta name="description" content={t.description} />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<link rel="alternate" hreflang="en" href={new URL(base, Astro.site).href} />
		<link rel="alternate" hreflang="fr" href={new URL(`${base}fr/`, Astro.site).href} />
		<meta property="og:title" content="Sumi" />
		<meta property="og:description" content={t.description} />
		<meta property="og:image" content={og} />
		<meta name="twitter:card" content="summary_large_image" />
		<style is:inline set:html={`:root{${motionVars()}}`} />
		{
			lang === 'en' && (
				<script is:inline>
					// A French browser arriving from elsewhere gets the French page; one coming from the docs stays put. A language picked by hand wins.
					try {
						const fromSite = document.referrer.startsWith(location.origin + location.pathname);
						const picked = localStorage.getItem('sumi-lang');
						if (!fromSite && (picked ? picked === 'fr' : /^fr\b/i.test(navigator.language))) location.replace('fr/' + location.search + location.hash);
					} catch {}
				</script>
			)
		}
	</head>
	<body>
		<button class="scrim" type="button" aria-label={t.closeMenu} hidden></button>

		<nav class="nav" data-ui aria-label={t.navLabel}>
			<div class="nav-bar">
				<a class="brand" href={prefix}>
					<svg aria-hidden="true" width="18" height="18" viewBox="192 192 640 640"><path transform="translate(0 15)" fill="currentColor" d={mark}></path></svg>
					<span>Sumi</span>
				</a>
				<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label={t.menu}>
					<span class="nav-toggle-text">{t.menu}</span>
					<svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
				</button>
				<a class="nav-download" href={download}>{t.download}</a>
			</div>
			<div class="menu" id="site-menu">
				<div class="menu-cols">
					<div>
						<p class="menu-label">{t.docs}</p>
						<a style="--i: 0" href={`${prefix}docs/install/`}>{t.install}</a>
						<a style="--i: 1" href={`${prefix}docs/privacy/`}>{t.privacy}</a>
						<a style="--i: 2" href={`${prefix}docs/contribute/`}>{t.contribute}</a>
					</div>
					<div>
						<p class="menu-label">{t.project}</p>
						<a style="--i: 1" href={`${prefix}#roadmap`}>{t.roadmapTitle}</a>
						<a style="--i: 1" href={`${repo}/releases`}>{t.releases}</a>
						<a style="--i: 2" href={repo}>{t.github}</a>
						<a style="--i: 3" href={`${repo}/discussions`}>{t.discussions}</a>
					</div>
				</div>
				<div class="menu-foot" style="--i: 4">
					<a class="menu-docs" href={`${prefix}docs/`}>{t.allDocs} <span aria-hidden="true">→</span></a>
					<a class="menu-lang" href={otherHome} data-lang={lang === 'fr' ? 'en' : 'fr'} lang={lang === 'fr' ? 'en' : 'fr'}>{t.otherLang}</a>
					<span class="menu-version">v{version}</span>
				</div>
			</div>
		</nav>

		<main>
			<section class="hero" aria-label="Sumi">
				<h1 class="sentence">
					<span class="half half-a">{t.h1a}</span>
					<span class="isle" data-ui data-state="dot" aria-hidden="true">
						<span class="layer layer-time" data-time>00:00</span>
						<span class="layer layer-music">
							<span class="art"></span>
							<span class="track">Tank!</span>
							<span class="eq"><i></i><i></i><i></i><i></i></span>
						</span>
						<span class="layer layer-mic" data-time>00:00</span>
						<span class="isle-tag"><i></i></span>
					</span>
					<span class="half half-b">{t.h1b}</span>
				</h1>
				<p class="steps">
					{t.steps.map((s, i) => <span class:list={['step', { on: i === 0 }]}>{s}</span>)}
				</p>
				<span class="cue" aria-hidden="true"></span>
				<div class="band">
					<Image src={painting} alt={t.paintingAlt} widths={[960, 1600, 2400]} sizes="100vw" loading="eager" />
				</div>
			</section>

			<section class="clip wrap" aria-labelledby="clip-title">
				<h2 id="clip-title" class="h2" data-reveal>{t.clipTitle}</h2>
				<p class="keys" data-reveal style="--d: 1">{t.clipLine}</p>
				<div class="clip-stage fits" data-ui data-reveal style="--d: 2" data-scene="clip" aria-hidden="true">
					<span class="scene-keys">Win + Alt + V</span>
					<iframe src={island} title="" tabindex="-1" aria-hidden="true" loading="lazy"></iframe>
				</div>
				<p class="ask-note" data-reveal style="--d: 3">{t.clipNote}</p>
				<p class="ask-note" data-reveal style="--d: 3">{t.clipPrivacy}</p>
			</section>

			<section class="ask wrap" aria-labelledby="ask-title">
				<h2 id="ask-title" class="h2" data-reveal>{t.askTitle}</h2>
				<p class="keys" data-reveal style="--d: 1">{t.askLine}</p>
				<div class="ask-stage fits" data-ui data-reveal style="--d: 2" data-app={t.askApp} data-question={t.askQuestion}>
					<iframe src={island} title="" tabindex="-1" aria-hidden="true" loading="lazy"></iframe>
				</div>
				<p class="ask-note" data-reveal style="--d: 3">{t.askNote}</p>
			</section>

			<section class="quiet wrap" aria-labelledby="quiet-title">
				<div class="quiet-head"><h2 id="quiet-title" class="h2" data-reveal>{t.quietTitle}</h2></div>
				<div class="quiet-rows">
					<article class="quiet-row" data-reveal>
						<div class="quiet-copy"><h3>{t.quiet[0].title}</h3><p>{t.quiet[0].text}</p></div>
						<div class="scene" data-ui data-scene="away" aria-hidden="true">
							<span class="scene-video"></span>
							<iframe src={island} title="" tabindex="-1" aria-hidden="true" loading="lazy"></iframe>
						</div>
					</article>
					<article class="quiet-row" data-reveal>
						<div class="quiet-copy"><h3>{t.quiet[1].title}</h3><p>{t.quiet[1].text}</p></div>
						<div class="scene" data-ui data-scene="back" aria-hidden="true">
							<iframe src={island} title="" tabindex="-1" aria-hidden="true" loading="lazy"></iframe>
							<svg class="cursor" width="22" height="22" viewBox="0 0 24 24"><path d="M4 2l7 19 2.6-7.4L21 11z" fill="#fff" stroke="#0B0B0F" stroke-width="1.6" stroke-linejoin="round"></path></svg>
						</div>
					</article>
					<p class="quiet-note" data-reveal>{t.quietNote}</p>
				</div>
			</section>

			<section class="roadmap wrap" id="roadmap" aria-labelledby="roadmap-title">
				<h2 id="roadmap-title" class="h2" data-reveal>{t.roadmapTitle}</h2>
				<ol class="rm">
					<li class="rm-row" data-reveal>
						<span class="rm-live" data-ui aria-hidden="true"><iframe src={island} title="" tabindex="-1" loading="lazy"></iframe></span>
						<span class="rm-copy"><strong>{t.roadmap[0].title}</strong><span>{t.roadmap[0].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[0].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live" data-ui aria-hidden="true"><iframe src={island} data-hover="hover" title="" tabindex="-1" loading="lazy"></iframe></span>
						<span class="rm-copy"><strong>{t.roadmap[1].title}</strong><span>{t.roadmap[1].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[1].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live" data-ui aria-hidden="true"><iframe src={island} data-hover="fullscreen" title="" tabindex="-1" loading="lazy"></iframe></span>
						<span class="rm-copy"><strong>{t.roadmap[2].title}</strong><span>{t.roadmap[2].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[2].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live split" data-ui aria-hidden="true" style={`--split: ${(GAP + BUBBLE) / 2}px`}>
							<iframe src={`${island}&${song}`} data-start="music" title="" tabindex="-1" loading="lazy"></iframe>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[3].title}</strong><span>{t.roadmap[3].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[3].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live split" data-ui aria-hidden="true" style={`--split: ${(TAG_GAP + TAG) / 2}px`}>
							<iframe src={island} data-start="mic" data-hover="mute" title="" tabindex="-1" loading="lazy"></iframe>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[4].title}</strong><span>{t.roadmap[4].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[4].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live fits" data-ui aria-hidden="true"><iframe src={island} data-start="bar" data-type={t.askApp} title="" tabindex="-1" loading="lazy"></iframe></span>
						<span class="rm-copy"><strong>{t.roadmap[5].title}</strong><span>{t.roadmap[5].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[5].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live split" data-ui aria-hidden="true" style={`--split: ${(GAP + BUBBLE) / 2}px`}>
							<iframe src={island} data-start="pasta" data-hover="hover" title="" tabindex="-1" loading="lazy"></iframe>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[6].title}</strong><span>{t.roadmap[6].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[6].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live" data-ui aria-hidden="true"><iframe src={island} data-hover="tuck" title="" tabindex="-1" loading="lazy"></iframe></span>
						<span class="rm-copy"><strong>{t.roadmap[7].title}</strong><span>{t.roadmap[7].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[7].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-icon" data-ui aria-hidden="true">
							<svg width="34" height="34" viewBox="0 0 1024 1024"><rect width="1024" height="1024" rx="224" fill="#0B0B0F"></rect><path transform="translate(0 15)" fill="#F4F1EA" d="M292 330H732A80 80 0 0 1 732 490H566C540 490 522.5 525.3 553.1 551A64 64 0 1 1 470.9 551C501.5 525.3 484 490 458 490H292A80 80 0 0 1 292 330Z"></path></svg>
							<i></i>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[8].title}</strong><span>{t.roadmap[8].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[8].tag}</span>
					</li>
					<li class="rm-row rm-tall" data-reveal>
						<span class="rm-live" data-ui aria-hidden="true"><iframe src={island} data-peek="weather" title="" tabindex="-1" loading="lazy"></iframe></span>
						<span class="rm-copy"><strong>{t.roadmap[9].title}</strong><span>{t.roadmap[9].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[9].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live" data-ui aria-hidden="true"><iframe src={island} data-peek="device" title="" tabindex="-1" loading="lazy"></iframe></span>
						<span class="rm-copy"><strong>{t.roadmap[10].title}</strong><span>{t.roadmap[10].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[10].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-live" data-ui aria-hidden="true"><iframe src={island} data-hover="capture" title="" tabindex="-1" loading="lazy"></iframe></span>
						<span class="rm-copy"><strong>{t.roadmap[11].title}</strong><span>{t.roadmap[11].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[11].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-pill" data-ui aria-hidden="true" style="--w0: 64px; --w1: 150px">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#e4e4e7" stroke-width="2" stroke-linecap="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"></path><circle cx="16" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle></svg>
							<span class="rm-more rm-dim">{t.roadmap[12].title}</span>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[12].title}</strong><span>{t.roadmap[12].text}</span></span>
						<span class="rm-tag rm-next">{t.roadmap[12].tag}</span>
					</li>
				</ol>
			</section>

			<section class="ink wrap" aria-labelledby="ink-title">
				<canvas class="ink-water" aria-hidden="true"></canvas>
				<div class="ink-body">
					<h2 id="ink-title" class="h2" data-reveal>{t.inkTitle}</h2>
					<p class="ink-text" data-reveal style="--d: 1">{t.ink}</p>
				</div>
			</section>
		</main>

		<footer class="end">
			<div class="wrap end-grid">
				<div>
					<h2 class="end-title" data-reveal>{t.endTitle}</h2>
					<p class="end-text" data-reveal style="--d: 1">{t.endText}</p>
					<a class="btn" href={download} data-reveal style="--d: 2">
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"></path></svg>
						{t.download}
					</a>
				</div>
				<ul class="end-links" data-reveal style="--d: 2">
					<li><a href={repo}>{t.github}</a></li>
					<li><a href={`${repo}/discussions`}>{t.discussions}</a></li>
					<li><a href={`${prefix}docs/`}>{t.docs}</a></li>
					<li><a href={otherHome} data-lang={lang === 'fr' ? 'en' : 'fr'} lang={lang === 'fr' ? 'en' : 'fr'}>{t.otherLang}</a></li>
				</ul>
			</div>
			<p class="wrap legal"><span>MIT · <a href={`${prefix}docs/legal/`}>{t.legalLink}</a></span><span>{t.credit}</span></p>
			<p class="giant" aria-hidden="true">Sumi</p>
		</footer>

		<script>
			import { inkWater } from '../scripts/fluid';
			import { formatTime, msUntilNextMinute } from '../../../src/lib/clock';

			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const nav = document.querySelector<HTMLElement>('.nav')!;
			const bar = nav.querySelector<HTMLElement>('.nav-bar')!;
			const menu = nav.querySelector<HTMLElement>('.menu')!;
			const toggle = nav.querySelector<HTMLButtonElement>('.nav-toggle')!;
			const scrim = document.querySelector<HTMLButtonElement>('.scrim')!;

			// The island is sized from its content, never from a guessed number.
			const fit = () => {
				const open = nav.classList.contains('open');
				const width = open ? Math.min(560, innerWidth - 32) : bar.scrollWidth;
				nav.style.width = `${width}px`;
				// The menu takes its final width at once, so its height is measured there, not at the width the island grows from.
				if (open) menu.style.width = `${width}px`;
				nav.style.height = `${bar.offsetHeight + (open ? menu.scrollHeight : 0)}px`;
			};
			let closing = 0;
			const setOpen = (open: boolean) => {
				// Keep the menu rendered while the island closes, then take it out of the page.
				clearTimeout(closing);
				if (!open && nav.classList.contains('open')) {
					nav.classList.add('closing');
					closing = window.setTimeout(() => nav.classList.remove('closing'), 450);
				}
				nav.classList.toggle('open', open);
				if (open) nav.classList.remove('compact');
				toggle.setAttribute('aria-expanded', String(open));
				scrim.hidden = !open;
				fit();
			};
			toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
			bar.addEventListener('click', (e) => {
				if (!nav.classList.contains('compact') || (e.target as Element).closest('.nav-download')) return;
				e.preventDefault();
				setOpen(true);
			});
			scrim.addEventListener('click', () => setOpen(false));
			menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape') return;
				if (nav.classList.contains('open')) {
					setOpen(false);
					toggle.focus();
				}
			});
			addEventListener('resize', fit);
			document.fonts.ready.then(fit);
			fit();

			// Compact while scrolling down, like the app at rest. A touchpad's few pixels back and forth don't count.
			let lastY = scrollY;
			addEventListener(
				'scroll',
				() => {
					if (scrollY > 160 && Math.abs(scrollY - lastY) < 24) return;
					const compact = !nav.classList.contains('open') && !nav.querySelector(':focus-visible') && scrollY > 160 && scrollY > lastY;
					if (compact !== nav.classList.contains('compact')) {
						nav.classList.toggle('compact', compact);
						fit();
					}
					lastY = scrollY;
				},
				{ passive: true },
			);
			// Compact hides the menu button; keyboard focus brings it back and keeps it while it stays.
			nav.addEventListener('focusin', (e) => {
				if (!nav.classList.contains('compact') || !(e.target as Element).matches(':focus-visible')) return;
				nav.classList.remove('compact');
				fit();
			});

			// A language picked by hand wins over the browser's next time.
			document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) =>
				a.addEventListener('click', () => {
					try {
						localStorage.setItem('sumi-lang', a.dataset.lang ?? 'en');
					} catch {}
				}),
			);

			// The visitor's own time, as the app and the live islands below write it, refreshed when the minute changes.
			const tick = () => {
				const now = new Date();
				const time = formatTime(now);
				document.querySelectorAll('[data-time]').forEach((el) => (el.textContent = time));
				setTimeout(tick, msUntilNextMinute(now));
			};
			tick();

			// The hero island: a dot that opens into the time, then plays through its states on its own.
			const hero = document.querySelector<HTMLElement>('.hero')!;
			const isle = hero.querySelector<HTMLElement>('.isle')!;
			const stepsEl = hero.querySelector<HTMLElement>('.steps')!;
			const steps = [...stepsEl.querySelectorAll<HTMLElement>('.step')];
			const states = ['time', 'music', 'mic'];
			let current = -1;
			const show = (i: number) => {
				current = i;
				isle.dataset.from = isle.dataset.state;
				isle.dataset.state = states[i];
				steps.forEach((s, j) => s.classList.toggle('on', j === i));
			};
			// WCAG 2.2.2: it plays two rounds and rests on the time, and holds still under the pointer, off screen
			// and in a background tab, so it never keeps moving next to what someone is reading.
			let left = reduce ? 0 : states.length * 2;
			let seen = false;
			let held = false;
			let next = 0;
			const play = () => {
				clearTimeout(next);
				if (current < 0 || !left || !seen || held || document.hidden) return;
				next = window.setTimeout(() => {
					left -= 1;
					show((current + 1) % states.length);
					play();
				}, 2200);
			};
			setTimeout(() => {
				show(0);
				play();
			}, reduce ? 0 : 450);
			new IntersectionObserver(([e]) => {
				seen = e.isIntersecting;
				play();
			}, { threshold: 0.5 }).observe(hero);
			document.addEventListener('visibilitychange', play);
			[isle, stepsEl].forEach((el) => {
				el.addEventListener('pointerenter', () => {
					held = true;
					play();
				});
				el.addEventListener('pointerleave', () => {
					held = false;
					play();
				});
			});

			// A frame that loaded before this script ran has already said it's ready: its demo is there.
			const loaded = (frame: HTMLIFrameElement) => !!frame.contentWindow && '__sumiDemo' in frame.contentWindow;
			// A line typed into a frame's command bar, a key every 70 ms: each step waits its own delay.
			const typing = (text: string, first = 70) =>
				[...text].map((_, i): [number, string] => [i ? 70 : first, `type:${text.slice(0, i + 1)}`]);

			// The roadmap's lines already out run the app's own island. Each plays while in view and undoes what it
			// started when it leaves; hovering the line, or tapping it on a touch screen, plays what that version brought.
			document.querySelectorAll<HTMLIFrameElement>('.rm-live iframe').forEach((frame) => {
				const row = frame.closest<HTMLElement>('.rm-row')!;
				const say = (name?: string) => name && frame.contentWindow?.postMessage(name, location.origin);
				const list = (key: string) => frame.dataset[key]?.split(' ').filter(Boolean) ?? [];
				let [ready, seen, started, on] = [loaded(frame), false, false, false];
				let keys: number[] = [];
				const type = (text: string) => {
					keys.forEach(clearTimeout);
					if (reduce || !text) return say(`type:${text}`);
					let at = 0;
					keys = typing(text).map(([ms, line]) => window.setTimeout(() => say(line), (at += ms)));
				};
				const start = () => {
					if (!ready || !seen || started) return;
					started = true;
					list('start').forEach(say);
					if (row.matches(':hover')) hover(true);
				};
				addEventListener('message', (e) => {
					if (e.source !== frame.contentWindow || e.data !== 'sumi:ready') return;
					ready = true;
					start();
				});
				// The demo's actions are toggles: sending the start list again stops it.
				new IntersectionObserver(([e]) => {
					seen = e.isIntersecting;
					if (seen) return start();
					if (!started) return;
					hover(false);
					list('start').forEach(say);
					started = false;
				}, { threshold: 0.6 }).observe(row);
				const hover = (next: boolean) => {
					if (!started || next === on) return;
					on = next;
					list('hover').forEach(say);
					// A peek ends by itself: it's asked for on the way in only.
					if (next) list('peek').forEach(say);
					if (frame.dataset.type) type(next ? frame.dataset.type : '');
				};
				row.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && hover(true));
				row.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && hover(false));
				row.addEventListener('click', (e) => e.pointerType !== 'mouse' && hover(!on));
			});
			// Every line, live or not, has CSS :hover rules: a click listener makes iOS Safari apply them on a tap, as Android does.
			document.querySelectorAll('.rm-row').forEach((row) => row.addEventListener('click', () => {}));

			// The clipboard history and the tuck, played by the app's own island: once as each comes into view, in under
			// 5 s, then again on hover or a tap once it's over. Each step is a message for the island, or a change around
			// it, `ms` after the start. `from` is sent as the frame loads, `end` instead with reduced motion, where nothing
			// plays and the island rests as its scene ends. `again` takes the island back to the start before a replay.
			// The scenes cut the 10 s rest short; the text says the real one.
			type Step = [number, string | ((stage: HTMLElement) => void)];
			const point = (stage: HTMLElement) => {
				const at = (ms: number) => ms / 3200;
				stage.querySelector('.cursor')!.animate(
					[
						{ offset: 0, opacity: 0, translate: '64px 104px', scale: 1 },
						{ offset: at(200), opacity: 1, translate: '64px 104px', easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
						{ offset: at(900), translate: '0 2px', scale: 1 },
						{ offset: at(1000), scale: 0.85 },
						{ offset: at(1120), translate: '0 2px', scale: 1, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
						{ offset: at(1800), translate: '0 24px', scale: 1 },
						{ offset: at(1900), translate: '0 24px', scale: 0.85, easing: 'cubic-bezier(0.65, 0, 0.35, 1)' },
						{ offset: at(2200), translate: '0 4px', scale: 0.85 },
						{ offset: at(2300), scale: 1, opacity: 1 },
						{ offset: at(2700), translate: '0 4px', opacity: 1 },
						{ offset: 1, translate: '24px 40px', opacity: 0, scale: 1 },
					],
					{ duration: 3200, fill: 'both' },
				);
			};
			const scenes: Record<string, { ms: number; from?: string[]; end?: string[]; again?: string; steps: Step[] }> = {
				// The keys, then the list: ↓ to the link with trackers, and Tab twice takes them off. It rests there, open.
				clip: {
					ms: 2800,
					end: ['clipboard', 'down', 'tab', 'tab'],
					again: 'clipboard',
					steps: [
						[0, (stage) => stage.classList.add('keyed')],
						[450, 'clipboard'],
						[450, (stage) => stage.classList.remove('keyed')],
						[1050, 'down'],
						[1600, 'tab'],
						[2150, 'tab'],
					],
				},
				// A video fills the screen and the island slides off; it ends, the time comes back, then tucks itself. It
				// comes back after, so the screen rests on the time.
				away: {
					ms: 4900,
					steps: [
						[0, (stage) => stage.classList.add('dark')],
						[300, 'fullscreen'],
						[1500, (stage) => stage.classList.remove('dark')],
						[1500, 'fullscreen'],
						[2900, 'tuck'],
						[4300, 'tuck'],
					],
				},
				// From the line: a click brings the island back, and a drag up tucks it again.
				back: {
					ms: 3900,
					from: ['tuck'],
					end: ['tuck'],
					steps: [
						[0, point],
						[1000, 'tuck'],
						[2100, 'tuck-up'],
					],
				},
			};
			document.querySelectorAll<HTMLElement>('[data-scene]').forEach((stage) => {
				const scene = scenes[stage.dataset.scene ?? ''];
				const frame = stage.querySelector('iframe')!;
				const say = (name: string) => frame.contentWindow?.postMessage(name, location.origin);
				let [ready, seen, played, until] = [false, false, false, 0];
				const run = (lead = 0) => {
					until = performance.now() + lead + scene.ms;
					scene.steps.forEach(([ms, step]) => setTimeout(() => (typeof step === 'string' ? say(step) : step(stage)), lead + ms));
				};
				const start = () => {
					if (reduce || !ready || !seen || played) return;
					run();
					played = true;
				};
				const replay = () => {
					if (reduce || !played || performance.now() < until) return;
					if (scene.again) say(scene.again);
					run(scene.again ? 700 : 0);
				};
				const greet = () => {
					if (ready) return;
					ready = true;
					// A message each 100 ms: the list opens before its keys arrive.
					(reduce ? scene.end : scene.from)?.forEach((name, i) => setTimeout(() => say(name), i * 100));
					start();
				};
				addEventListener('message', (e) => e.source === frame.contentWindow && e.data === 'sumi:ready' && greet());
				if (loaded(frame)) greet();
				new IntersectionObserver(([e]) => {
					seen = e.isIntersecting;
					start();
				}, { threshold: 0.6 }).observe(stage);
				const area = stage.closest<HTMLElement>('.quiet-row') ?? stage;
				area.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && replay());
				area.addEventListener('click', (e) => e.pointerType !== 'mouse' && replay());
			});

			// The scroll cue leaves for good with the first real scroll.
			const scrolled = () => {
				if (scrollY < 16) return;
				hero.classList.add('scrolled');
				removeEventListener('scroll', scrolled);
			};
			addEventListener('scroll', scrolled, { passive: true });

			// The bar is wider than its line's column and than a phone: its frames scale to fit.
			const fits = new ResizeObserver((entries) =>
				entries.forEach((e) => (e.target as HTMLElement).style.setProperty('--fit', String(e.contentRect.width / 480))),
			);
			document.querySelectorAll('.fits').forEach((el) => fits.observe(el));

			// The command bar, played once by the app's own island when it comes into view: an app, a timer, a question.
			// It rests on the question and the chip that answers it, as it does with reduced motion. It holds still under
			// the pointer, off screen and in a background tab.
			const stage = document.querySelector<HTMLElement>('.ask-stage')!;
			const askFrame = stage.querySelector('iframe')!;
			const tell = (name: string) => askFrame.contentWindow?.postMessage(name, location.origin);
			const script: [number, string][] = reduce
				? [
						[0, 'bar'],
						[400, `type:${stage.dataset.question ?? ''}`],
					]
				: [
						[900, 'bar'],
						...typing(stage.dataset.app ?? '', 400),
						[900, 'enter'],
						[2800, 'bar'],
						...typing('25m', 400),
						[900, 'enter'],
						[2600, 'clear'],
						[700, 'bar'],
						...typing(stage.dataset.question ?? '', 400),
					];
			let [askReady, askSeen, askHeld, step, wait] = [loaded(askFrame), false, false, 0, 0];
			const advance = () => {
				clearTimeout(wait);
				if (!askReady || !askSeen || askHeld || document.hidden || step >= script.length) return;
				const [ms, name] = script[step];
				wait = window.setTimeout(() => {
					step += 1;
					tell(name);
					advance();
				}, ms);
			};
			addEventListener('message', (e) => {
				if (e.source !== askFrame.contentWindow || e.data !== 'sumi:ready') return;
				askReady = true;
				advance();
			});
			new IntersectionObserver(
				([e]) => {
					askSeen = e.isIntersecting;
					advance();
				},
				{ threshold: 0.6 },
			).observe(stage);
			document.addEventListener('visibilitychange', advance);
			stage.addEventListener('pointerenter', () => {
				askHeld = true;
				advance();
			});
			stage.addEventListener('pointerleave', () => {
				askHeld = false;
				advance();
			});

		// Each section's parts rise in, once, as they arrive.
			const io = new IntersectionObserver(
				(entries) =>
					entries.forEach((e) => {
						if (!e.isIntersecting) return;
						e.target.classList.add('in');
						io.unobserve(e.target);
					}),
				{ rootMargin: '0px 0px -12% 0px' },
			);
			document.documentElement.classList.add('js');
			document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

			const water = document.querySelector<HTMLElement>('.ink');
			const waterCanvas = document.querySelector<HTMLCanvasElement>('.ink-water');
			if (water && waterCanvas) inkWater(water, waterCanvas, reduce);
		</script>
	</body>
</html>

