---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import { Image } from 'astro:assets';
import pkg from '../../../package.json';
import painting from '../assets/jinshan-band.webp';
import { home, type Lang } from '../i18n/home';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = home[lang];
const version = pkg.version;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = lang === 'fr' ? `${base}fr/` : base;
const otherHome = lang === 'fr' ? base : `${base}fr/`;
const download = 'https://github.com/Rateur/sumi/releases/latest/download/Sumi-setup.exe';
const repo = 'https://github.com/Rateur/sumi';
const q = encodeURIComponent(t.askValue);
const mark =
	'M292 330H732A80 80 0 0 1 732 490H566C540 490 522.5 525.3 553.1 551A64 64 0 1 1 470.9 551C501.5 525.3 484 490 458 490H292A80 80 0 0 1 292 330Z';
const og = new URL(`${base}og.png`, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.title}</title>
		<meta name="description" content={t.description} />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<link rel="alternate" hreflang="en" href={new URL(base, Astro.site).href} />
		<link rel="alternate" hreflang="fr" href={new URL(`${base}fr/`, Astro.site).href} />
		<meta property="og:title" content="Sumi" />
		<meta property="og:description" content={t.description} />
		<meta property="og:image" content={og} />
		<meta name="twitter:card" content="summary_large_image" />
		{
			lang === 'en' && (
				<script is:inline>
					// First visit only: a French browser gets the French page. A language picked by hand wins.
					try {
						if (!localStorage.getItem('sumi-lang') && /^fr\b/i.test(navigator.language)) location.replace('fr/');
					} catch {}
				</script>
			)
		}
	</head>
	<body>
		<button class="scrim" type="button" aria-label={t.closeMenu} hidden></button>

		<nav class="nav" data-ui aria-label="Main">
			<div class="nav-bar">
				<a class="brand" href={prefix}>
					<svg aria-hidden="true" width="18" height="18" viewBox="192 192 640 640"><path transform="translate(0 15)" fill="currentColor" d={mark}></path></svg>
					<span>Sumi</span>
				</a>
				<span class="nav-timer" hidden>
					<svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2.5 2M10 2h4"></path></svg>
					<span class="nav-timer-value">0:00</span>
					<button class="nav-timer-stop" type="button" aria-label={t.stopTimer}><svg aria-hidden="true" width="9" height="9" viewBox="0 0 10 10"><rect width="10" height="10" rx="2" fill="currentColor"></rect></svg></button>
				</span>
				<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label={t.menu}>
					<span class="nav-toggle-text">{t.menu}</span>
					<svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
				</button>
				<a class="nav-download" href={download}>{t.download}</a>
			</div>
			<div class="menu" id="site-menu">
				<div class="menu-cols">
					<div>
						<p class="menu-label">{t.docs}</p>
						<a style="--i: 0" href={`${prefix}docs/install/`}>{t.install}</a>
						<a style="--i: 1" href={`${prefix}docs/time/`}>{t.time}</a>
						<a style="--i: 2" href={`${prefix}docs/privacy/`}>{t.privacy}</a>
					</div>
					<div>
						<p class="menu-label">{t.project}</p>
						<a style="--i: 1" href={`${prefix}#roadmap`}>{t.roadmapTitle}</a>
						<a style="--i: 1" href={`${repo}/releases`}>{t.releases}</a>
						<a style="--i: 2" href={repo}>{t.github}</a>
						<a style="--i: 3" href={`${repo}/discussions`}>{t.discussions}</a>
					</div>
				</div>
				<div class="menu-foot" style="--i: 4">
					<a class="menu-lang" href={otherHome} data-lang={lang === 'fr' ? 'en' : 'fr'} lang={lang === 'fr' ? 'en' : 'fr'}>{t.otherLang}</a>
					<span class="menu-version">v{version}</span>
				</div>
			</div>
			<div class="answer" aria-live="polite">
				<div class="answer-head">
					<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24"><path fill="#f472b6" d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path></svg>
					<span class="answer-who">Claude</span>
					<button class="answer-close" type="button" aria-label={t.closeAnswer}><svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
				</div>
				<p class="answer-text"></p>
				<p class="answer-source" hidden>{t.wikiSource}</p>
			</div>
		</nav>

		<main>
			<section class="hero" aria-label="Sumi">
				<div class="hero-stage">
					<h1 class="sentence">
						<span class="half half-a">{t.h1a}</span>
						<span class="isle" data-ui data-state="dot" aria-hidden="true">
							<span class="layer layer-time" data-time>00:00</span>
							<span class="layer layer-music">
								<span class="art"></span>
								<span class="track">Tank!</span>
								<span class="eq"><i></i><i></i><i></i><i></i></span>
							</span>
							<span class="layer layer-timer"><span class="dot-mic"></span>24:59</span>
						</span>
						<span class="half half-b">{t.h1b}</span>
					</h1>
					<p class="steps" aria-live="polite">
						{t.steps.map((s, i) => <span class:list={['step', { on: i === 0 }]}>{s}</span>)}
					</p>
					<div class="band">
						<Image src={painting} alt={t.paintingAlt} widths={[960, 1600, 2400]} sizes="100vw" loading="eager" />
					</div>
				</div>
			</section>

			<section class="ask wrap" aria-labelledby="ask-title">
				<h2 id="ask-title" class="h2" data-reveal>{t.askTitle}</h2>
				<p class="keys" data-reveal style="--d: 1">{t.askKeys}</p>
				<div class="ask-box" data-ui data-reveal style="--d: 2" data-demo={t.askValue} data-answers={JSON.stringify(t.answers)} data-web-name={t.webName} data-actions={t.actions} data-install={t.installHint} data-nothing={t.wikiNothing}>
					<label class="ask-field">
						<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="#f472b6" d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path></svg>
						<input class="ask-input" type="text" placeholder={t.askPlaceholder} aria-label={t.askLabel} autocomplete="off" spellcheck="false" />
						<span class="ask-chip" aria-hidden="true">Claude</span>
					</label>
					<div class="ask-answer">
						<a class="ask-row is-active" data-engine="claude" href={`https://claude.ai/new?q=${q}`} target="_blank" rel="noopener">
							<span>{t.askClaude}</span><kbd>Enter</kbd>
						</a>
						<a class="ask-row" data-engine="chatgpt" href={`https://chatgpt.com/?q=${q}`} target="_blank" rel="noopener"><span>{t.askChatGPT}</span></a>
						<a class="ask-row" data-engine="web" href={`https://duckduckgo.com/?q=${q}`} target="_blank" rel="noopener"><span>{t.askWeb}</span></a>
						<button class="ask-row ask-timer" type="button" hidden data-template={t.askTimer}><span></span><kbd>Enter</kbd></button>
					</div>
				</div>
				<p class="examples" data-reveal style="--d: 3">
					{t.askExamples.map((e) => <button class="example" type="button">{e}</button>)}
				</p>
			</section>

			<section class="quiet wrap" aria-labelledby="quiet-title">
				<div class="quiet-head"><h2 id="quiet-title" class="h2" data-reveal>{t.quietTitle}</h2></div>
				<div class="quiet-rows">
					<article class="quiet-row" data-reveal>
						<div class="quiet-copy"><h3>{t.quiet[0].title}</h3><p>{t.quiet[0].text}</p></div>
						<div class="frag frag-click" data-ui aria-hidden="true">
							<span class="frag-isle" data-time>00:00</span>
							<span class="frag-window"></span>
							<svg class="cursor" width="22" height="22" viewBox="0 0 24 24"><path d="M4 2l7 19 2.6-7.4L21 11z" fill="#fff" stroke="#0B0B0F" stroke-width="1.6" stroke-linejoin="round"></path></svg>
						</div>
					</article>
					<article class="quiet-row" data-reveal>
						<div class="quiet-copy"><h3>{t.quiet[1].title}</h3><p>{t.quiet[1].text}</p></div>
						<div class="frag frag-focus" data-ui aria-hidden="true">
							<span class="frag-isle" data-time>00:00</span>
							<span class="frag-game"><i></i><i></i><i></i></span>
							<span class="frag-taskbar"><i></i><i></i><i></i><i></i></span>
						</div>
					</article>
					<article class="quiet-row" data-reveal>
						<div class="quiet-copy"><h3>{t.quiet[2].title}</h3><p>{t.quiet[2].text}</p></div>
						<div class="frag frag-file" data-ui aria-hidden="true">
							<span class="file-icon"><svg width="34" height="34" viewBox="192 192 640 640"><path transform="translate(0 15)" fill="#F4F1EA" d={mark}></path></svg></span>
							<span class="file-name">Sumi-setup.exe</span>
							<span class="file-size">1.1 MB</span>
						</div>
					</article>
				</div>
			</section>

			<section class="roadmap wrap" id="roadmap" aria-labelledby="roadmap-title">
				<h2 id="roadmap-title" class="h2" data-reveal>{t.roadmapTitle}</h2>
				<ol class="rm">
					<li class="rm-row" data-reveal>
						<span class="rm-pill" data-ui aria-hidden="true" style="--w0: 132px; --w1: 236px"><span class="rm-more rm-dim" data-date></span><span data-time>00:00</span></span>
						<span class="rm-copy"><strong>{t.roadmap[0].title}</strong><span>{t.roadmap[0].text}</span></span>
						<span class="rm-tag rm-done">{t.roadmap[0].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-pill rm-peek" data-ui aria-hidden="true" style="--w0: 132px; --w1: 300px">
							<span class="rm-art"></span><span class="rm-more"><b>Tank!</b> <span class="rm-dim">Seatbelts</span></span><span class="rm-swap" data-time>00:00</span>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[1].title}</strong><span>{t.roadmap[1].text}</span></span>
						<span class="rm-tag rm-next">{t.roadmap[1].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-pill rm-music" data-ui aria-hidden="true" style="--w0: 200px; --w1: 300px">
							<span class="rm-art"></span><span class="rm-more"><b>Tank!</b> <span class="rm-dim">Seatbelts</span></span><span class="rm-eq"><i></i><i></i><i></i><i></i></span>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[2].title}</strong><span>{t.roadmap[2].text}</span></span>
						<span class="rm-tag">{t.roadmap[2].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-pill" data-ui aria-hidden="true" style="--w0: 150px; --w1: 240px"><span data-time>00:00</span><span class="rm-dots"><i></i><i></i></span><span class="rm-more rm-dim">Discord</span></span>
						<span class="rm-copy"><strong>{t.roadmap[3].title}</strong><span>{t.roadmap[3].text}</span></span>
						<span class="rm-tag">{t.roadmap[3].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-pill rm-ask" data-ui aria-hidden="true" style="--w0: 210px; --w1: 320px">
							<svg width="13" height="13" viewBox="0 0 24 24"><path fill="#f472b6" d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path></svg>
							<span class="rm-dim">{t.askLabel}…</span><span class="rm-more rm-chip">Claude</span>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[4].title}</strong><span>{t.roadmap[4].text}</span></span>
						<span class="rm-tag">{t.roadmap[4].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-pill rm-timer" data-ui aria-hidden="true" style="--w0: 112px; --w1: 236px"><span>24:59</span><span class="rm-more">{t.timesUp}</span></span>
						<span class="rm-copy"><strong>{t.roadmap[5].title}</strong><span>{t.roadmap[5].text}</span></span>
						<span class="rm-tag">{t.roadmap[5].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-pill" data-ui aria-hidden="true" style="--w0: 112px; --w1: 220px">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path></svg>
							<span>12°</span><span class="rm-more rm-dim">{t.sunny}</span>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[6].title}</strong><span>{t.roadmap[6].text}</span></span>
						<span class="rm-tag">{t.roadmap[6].tag}</span>
					</li>
					<li class="rm-row" data-reveal>
						<span class="rm-pill rm-battery" data-ui aria-hidden="true" style="--w0: 120px; --w1: 236px">
							<span class="rm-more">{t.charging}</span><span>64%</span>
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="18" height="10" rx="2.5"></rect><path d="M22 11v2"></path><path d="M12 8.5l-3 4h4l-2 3"></path></svg>
						</span>
						<span class="rm-copy"><strong>{t.roadmap[7].title}</strong><span>{t.roadmap[7].text}</span></span>
						<span class="rm-tag">{t.roadmap[7].tag}</span>
					</li>
				</ol>
			</section>

			<section class="ink wrap" aria-labelledby="ink-title">
				<canvas class="ink-water" aria-hidden="true"></canvas>
				<div class="ink-body">
					<h2 id="ink-title" class="h2" data-reveal>{t.inkTitle}</h2>
					<p class="ink-text" data-reveal style="--d: 1">{t.ink}</p>
				</div>
			</section>
		</main>

		<footer class="end">
			<div class="wrap end-grid">
				<div>
					<h2 class="end-title" data-reveal>{t.endTitle}</h2>
					<p class="end-text" data-reveal style="--d: 1">{t.endText}</p>
					<a class="btn" href={download} data-reveal style="--d: 2">
						<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"></path></svg>
						{t.download}
					</a>
				</div>
				<ul class="end-links" data-reveal style="--d: 2">
					<li><a href={repo}>{t.github}</a></li>
					<li><a href={`${repo}/discussions`}>{t.discussions}</a></li>
					<li><a href={`${prefix}docs/install/`}>{t.docs}</a></li>
					<li><a href={otherHome} data-lang={lang === 'fr' ? 'en' : 'fr'} lang={lang === 'fr' ? 'en' : 'fr'}>{t.otherLang}</a></li>
				</ul>
			</div>
			<p class="wrap legal"><span>MIT · <a href={`${prefix}docs/legal/`}>{t.legalLink}</a></span><span>{t.credit}</span></p>
			<p class="giant" aria-hidden="true">Sumi</p>
		</footer>

		<script>
			import { inkWater } from '../scripts/fluid';

			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const nav = document.querySelector<HTMLElement>('.nav')!;
			const bar = nav.querySelector<HTMLElement>('.nav-bar')!;
			const menu = nav.querySelector<HTMLElement>('.menu')!;
			const toggle = nav.querySelector<HTMLButtonElement>('.nav-toggle')!;
			const scrim = document.querySelector<HTMLButtonElement>('.scrim')!;
			const timerEl = nav.querySelector<HTMLElement>('.nav-timer')!;
			const timerValue = nav.querySelector<HTMLElement>('.nav-timer-value')!;
		const answerEl = nav.querySelector<HTMLElement>('.answer')!;

			// The island is sized from its content, never from a guessed number.
			const fit = () => {
				const open = nav.classList.contains('open');
				const answering = nav.classList.contains('answering');
				const width = open ? Math.min(560, innerWidth - 32) : answering ? Math.min(460, innerWidth - 32) : bar.scrollWidth;
				nav.style.width = `${width}px`;
				const extra = open ? menu.scrollHeight : answering ? answerEl.scrollHeight : 0;
				nav.style.height = `${bar.offsetHeight + extra}px`;
			};
			let closing = 0;
			const setOpen = (open: boolean) => {
				// Keep the menu rendered while the island closes, then take it out of the page.
				clearTimeout(closing);
				if (!open && nav.classList.contains('open')) {
					nav.classList.add('closing');
					closing = window.setTimeout(() => nav.classList.remove('closing'), 450);
				}
				nav.classList.toggle('open', open);
				if (open) nav.classList.remove('compact');
				if (open) nav.classList.remove('answering');
				toggle.setAttribute('aria-expanded', String(open));
				scrim.hidden = !open;
				fit();
			};
			toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
			const closeAnswer = () => {
			nav.classList.remove('answering');
			scrim.hidden = !nav.classList.contains('open');
			fit();
		};
		scrim.addEventListener('click', () => {
			setOpen(false);
			closeAnswer();
		});
		answerEl.querySelector('.answer-close')!.addEventListener('click', closeAnswer);
			menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape') return;
				if (nav.classList.contains('answering')) closeAnswer();
				if (nav.classList.contains('open')) {
					setOpen(false);
					toggle.focus();
				}
			});
			addEventListener('resize', fit);
			document.fonts.ready.then(fit);
			fit();

			// Compact while scrolling down, like the app at rest.
			let lastY = scrollY;
			addEventListener(
				'scroll',
				() => {
					const compact = !nav.classList.contains('open') && !nav.classList.contains('answering') && scrollY > 160 && scrollY > lastY;
					if (compact !== nav.classList.contains('compact')) {
						nav.classList.toggle('compact', compact);
						fit();
					}
					lastY = scrollY;
				},
				{ passive: true },
			);

			// A language picked by hand wins over the browser's next time.
			document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) =>
				a.addEventListener('click', () => {
					try {
						localStorage.setItem('sumi-lang', a.dataset.lang ?? 'en');
					} catch {}
				}),
			);

			// The visitor's own time, refreshed when the minute changes.
			const lang = document.documentElement.lang;
			const tick = () => {
				const now = new Date();
				const time = now.toLocaleTimeString(lang, { hour: '2-digit', minute: '2-digit' });
				const date = now.toLocaleDateString(lang, { weekday: 'short', day: 'numeric', month: 'short' });
				document.querySelectorAll('[data-time]').forEach((el) => (el.textContent = time));
				document.querySelectorAll('[data-date]').forEach((el) => (el.textContent = date));
				setTimeout(tick, 60_000 - (now.getSeconds() * 1000 + now.getMilliseconds()));
			};
			tick();

			// The hero island: a dot that opens into the time, then follows the scroll through its states.
			const hero = document.querySelector<HTMLElement>('.hero')!;
			const isle = hero.querySelector<HTMLElement>('.isle')!;
			const steps = [...hero.querySelectorAll<HTMLElement>('.step')];
			const states = ['time', 'music', 'timer'];
			let current = -1;
			const show = (i: number) => {
				if (i === current) return;
				current = i;
				isle.dataset.state = states[i];
				steps.forEach((s, j) => s.classList.toggle('on', j === i));
			};
			// Left alone, the island moves on by itself; scrolling takes over.
			let idle = 0;
			const autoplay = () => {
				clearTimeout(idle);
				if (reduce) return;
				idle = window.setTimeout(() => {
					if (hero.getBoundingClientRect().bottom > innerHeight * 0.5) show((current + 1) % states.length);
					autoplay();
				}, 3200);
			};
			setTimeout(() => {
				show(0);
				autoplay();
			}, reduce ? 0 : 450);
			const onScroll = () => {
				if (current < 0) return;
				const r = hero.getBoundingClientRect();
				const p = Math.min(0.999, Math.max(0, -r.top / (r.height - innerHeight)));
				show(Math.floor(p * states.length));
				autoplay();
			};
			addEventListener('scroll', () => requestAnimationFrame(onScroll), { passive: true });

			// The command bar, working as it will in the app.
			const input = document.querySelector<HTMLInputElement>('.ask-input')!;
			const rows = [...document.querySelectorAll<HTMLAnchorElement>('a.ask-row')];
			const timerRow = document.querySelector<HTMLButtonElement>('.ask-timer')!;
			const urls: Record<string, string> = {
				claude: 'https://claude.ai/new?q=',
				chatgpt: 'https://chatgpt.com/?q=',
				web: 'https://duckduckgo.com/?q=',
			};
			const parseTimer = (v: string) => {
				const m = v.trim().match(/^(\d{1,3})\s*(s|m|min|h)$/i);
				if (!m) return 0;
				const n = Number(m[1]);
				const unit = m[2].toLowerCase();
				return unit === 's' ? n : unit === 'h' ? n * 3600 : n * 60;
			};
			const clock = (s: number) => {
				const h = Math.floor(s / 3600);
				const m = Math.floor((s % 3600) / 60);
				const sec = String(s % 60).padStart(2, '0');
				return h ? `${h}:${String(m).padStart(2, '0')}:${sec}` : `${m}:${sec}`;
			};
			const update = () => {
				const v = input.value.trim();
				const seconds = parseTimer(v);
				timerRow.hidden = !seconds;
				if (seconds) timerRow.querySelector('span')!.textContent = (timerRow.dataset.template ?? '').replace('{t}', clock(seconds));
				rows.forEach((row, i) => {
					row.href = urls[row.dataset.engine!] + encodeURIComponent(v);
					row.classList.toggle('is-active', !seconds && i === 0);
				});
				timerRow.classList.toggle('is-active', !!seconds);
			};
			let countdown = 0;
			const startTimer = (seconds: number) => {
				clearInterval(countdown);
				let left = seconds;
				nav.classList.add('timing');
				timerEl.hidden = false;
				timerValue.textContent = clock(left);
				fit();
				countdown = window.setInterval(() => {
					left -= 1;
					timerValue.textContent = clock(Math.max(0, left));
					if (left <= 0) {
						clearInterval(countdown);
						nav.classList.add('done');
						setTimeout(() => {
							nav.classList.remove('timing', 'done');
							timerEl.hidden = true;
							fit();
						}, 2400);
					}
				}, 1000);
			};
			const stopTimer = () => {
			clearInterval(countdown);
			nav.classList.remove('timing', 'done');
			timerEl.hidden = true;
			fit();
		};
		nav.querySelector('.nav-timer-stop')!.addEventListener('click', stopTimer);
		timerRow.addEventListener('click', () => startTimer(parseTimer(input.value)));
			input.addEventListener('input', update);
			input.addEventListener('keydown', (e) => {
				if (e.key !== 'Enter') return;
				e.preventDefault();
				const seconds = parseTimer(input.value);
				if (seconds) startTimer(seconds);
				else answer('claude');
			});
			document.querySelectorAll<HTMLButtonElement>('.example').forEach((b) =>
				b.addEventListener('click', () => {
					input.value = b.textContent ?? '';
					update();
					input.focus();
				}),
			);
			update();

			// The first time the bar comes into view, a question types itself, unless the visitor got there first.
			const box = document.querySelector<HTMLElement>('.ask-box')!;
			const typeDemo = () => {
				if (input.value || document.activeElement === input) return;
				const text = box.dataset.demo ?? '';
				if (reduce) {
					input.value = text;
					update();
					return;
				}
				let i = 0;
				const step = () => {
					if (document.activeElement === input) return;
					input.value = text.slice(0, ++i);
					update();
					if (i < text.length) setTimeout(step, 45 + Math.random() * 50);
				};
				setTimeout(step, 500);
			};
			new IntersectionObserver(
				([e], o) => {
					if (!e.isIntersecting) return;
					typeDemo();
					o.disconnect();
				},
				{ threshold: 0.6 },
			).observe(box);

			// Asking: the island answers. The examples get an exact answer, actions only the app can do point to it,
			// anything else gets a Wikipedia summary (public API, free and keyless, called only on this click).
			const answers: Record<string, string> = JSON.parse(box.dataset.answers ?? '{}');
			const names: Record<string, string> = { claude: 'Claude', chatgpt: 'ChatGPT', web: box.dataset.webName ?? 'Web' };
			const actions = new RegExp(box.dataset.actions ?? '^$', 'i');
			const who = answerEl.querySelector<HTMLElement>('.answer-who')!;
			const said = answerEl.querySelector<HTMLElement>('.answer-text')!;
			const source = answerEl.querySelector<HTMLElement>('.answer-source')!;
			const wiki = async (q: string) => {
				const host = `https://${lang === 'fr' ? 'fr' : 'en'}.wikipedia.org`;
				try {
					const found = await fetch(`${host}/w/api.php?action=query&list=search&srlimit=1&format=json&origin=*&srsearch=${encodeURIComponent(q)}`).then((r) => r.json());
					const title: string | undefined = found?.query?.search?.[0]?.title;
					if (!title) return '';
					const page = await fetch(`${host}/api/rest_v1/page/summary/${encodeURIComponent(title)}`).then((r) => r.json());
					const text: string = page?.extract ?? '';
					return text.length > 320 ? `${text.slice(0, 317).trimEnd()}…` : text;
				} catch {
					return '';
				}
			};
			let typing = 0;
			let asked = 0;
			const answer = async (engine: string) => {
				const q = input.value.trim();
				if (!q) return input.focus();
				const ticket = ++asked;
				clearTimeout(typing);
				setOpen(false);
				who.textContent = names[engine];
				said.textContent = '';
				said.classList.add('thinking');
				source.hidden = true;
				nav.classList.remove('compact');
				nav.classList.add('answering');
				scrim.hidden = false;
				fit();
				const started = performance.now();
				let full = answers[q.toLowerCase()];
				if (!full && actions.test(q)) full = box.dataset.install ?? '';
				if (!full) {
					full = await wiki(q);
					if (full) source.hidden = false;
					else full = box.dataset.nothing ?? '';
				}
			if (ticket !== asked) return;
			let i = 0;
			const type = () => {
				said.textContent = full.slice(0, ++i);
				fit();
				if (i < full.length) typing = window.setTimeout(type, 12);
			};
			typing = window.setTimeout(
				() => {
					said.classList.remove('thinking');
					if (reduce) {
						said.textContent = full;
						fit();
					} else type();
				},
				reduce ? 0 : Math.max(0, 900 - (performance.now() - started)),
			);
		};
		rows.forEach((row) =>
			row.addEventListener('click', (e) => {
				e.preventDefault();
				answer(row.dataset.engine!);
			}),
		);

		// Each section's parts rise in, once, as they arrive.
			const io = new IntersectionObserver(
				(entries) =>
					entries.forEach((e) => {
						if (!e.isIntersecting) return;
						e.target.classList.add('in');
						io.unobserve(e.target);
					}),
				{ rootMargin: '0px 0px -12% 0px' },
			);
			document.documentElement.classList.add('js');
			document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

			const water = document.querySelector<HTMLElement>('.ink');
			const waterCanvas = document.querySelector<HTMLCanvasElement>('.ink-water');
			if (water && waterCanvas) inkWater(water, waterCanvas, reduce);
		</script>
	</body>
</html>

